# Base URL of the Reborn Go API used by server-side fetches (server components, sitemap).
API_URL=http://localhost:8080
# Base URL of the Reborn Go API used by the browser (signed-in features). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public URL of this site, used for canonical URLs, Open Graph, sitemap and robots.
SITE_URL=http://localhost:3000
