{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appsotechltd/reborn/content/schema/library-file.schema.json",
  "title": "Reborn library file",
  "type": "object",
  "required": ["source", "cards"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "#/$defs/source" },
    "cards": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/card" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "source": {
      "type": "object",
      "required": ["id", "title", "authors", "kind", "url", "licence", "licence_url", "attribution", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "kind": { "enum": ["book", "textbook", "article", "guide", "study", "talk", "podcast", "video"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "licence": { "enum": ["public-domain", "us-gov-public-domain", "cc-by-4.0", "cc-by-3.0", "cc-by-sa-4.0", "cc0-1.0", "ogl-3.0", "original-summary"] },
        "licence_url": { "type": "string", "pattern": "^https?://" },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string" },
        "year": { "type": "integer" },
        "language": { "type": "string", "default": "en" },
        "translator": { "type": "string" },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "topic", "title", "body", "apply_it"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*--[0-9]{2,3}$" },
        "topic": { "enum": ["business", "psychology", "mental-strength", "health", "emotional-intelligence", "personal-development", "productivity", "money", "relationships", "dating-marriage", "mindfulness", "faith-wisdom", "leadership", "parenting", "communication", "creativity", "learning", "lives-history", "entrepreneurship"] },
        "tags": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/slug" } },
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "quote": { "type": "string", "maxLength": 300 },
        "apply_it": { "type": "string", "minLength": 1, "maxLength": 240 },
        "locator": { "type": "string", "maxLength": 120 },
        "health": { "type": "boolean", "default": false },
        "language": { "type": "string" },
        "quiz": {
          "type": "object",
          "required": ["question", "options", "answer"],
          "additionalProperties": false,
          "properties": {
            "question": { "type": "string", "minLength": 1, "maxLength": 200 },
            "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
            "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
            "explanation": { "type": "string", "maxLength": 300 }
          }
        }
      }
    }
  }
}
